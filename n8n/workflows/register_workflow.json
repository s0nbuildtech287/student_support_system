            "parameters": {
                "jsCode": "// Get created user from MySQL\nconst items = $input.all();\n\nif (items.length > 0 && items[0].json) {\n  const user = items[0].json;\n  \n  return {\n    json: {\n      success: true,\n      message: \"Registration successful\",\n      user: {\n        id: user.id,\n        name: user.name,\n        email: user.email,\n        phone: user.phone,\n        created_at: user.created_at\n      }\n    }\n  };\n}\n\n// Failure\nreturn {\n  json: {\n    success: false,\n    message: \"Registration failed\",\n    user: null\n  }\n};"
